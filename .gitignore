# ============================================================================
# Build outputs (regenerate with buildc.sh / buildgfx.sh / buildhook.sh)
# ============================================================================
*.o
*.elf
*.bin
*.a
build_*/

# U-Boot script images, generated from the .txt sources by mkscript.py
*.scr

# ============================================================================
# Development runs and captured output
# ============================================================================
# Serial console captures (MobaXterm logs, pasted runs)
*.log
*.rtf
MobaXterm_*
run[0-9]*.txt
tx[0-9]*.txt

# Register snapshot diffs and analysis output (regenerate with the .py tools)
snapdiff.txt
accessors_*.txt
app_strings.txt
avcpu_strings.txt

# ============================================================================
# Original firmware and images extracted from it
# ----------------------------------------------------------------------------
# NOT committed on purpose: the flash dump holds private data (saved WiFi
# names/passwords, vendor FTP login, DRM keys) and the vendor's copyrighted
# code. Keep backup.bin safe elsewhere (e.g. on the USB stick) — it is the
# only way to restore the box. Delete this section to track them anyway.
# ============================================================================
backup*.bin
app_ram.bin
uboot_part.bin
avcpu.bin

# ============================================================================
# Third-party files that are downloaded, not ours
# ----------------------------------------------------------------------------
# Linux rtl8xxxu sources (reference only, GPL-2.0-only) and test media
# (music is someone else's copyright). The RTL8188F firmware blob is
# already covered by *.bin; get it from linux-firmware (rtlwifi/).
# ============================================================================
rtl8188/
*.wav
*.mp3
*.mp4
*.bav

# Generated by mksine.py
sine256.h

# ============================================================================
# Editor / OS clutter
# ============================================================================
__pycache__/
*.pyc
*:Zone.Identifier
*.Zone.Identifier
Thumbs.db
desktop.ini
.vscode/

# Doom: game data is commercial (never commit), doomgeneric is downloaded
*.wad
*.WAD
doom/doomgeneric/
doom/chocolate/
ncapps/local.sh
VDECTBL.BIN
WIFI.TXT
vk.dis

# Satellite box: vendor firmware strings / disassembly
sat/*_strings.txt
*.dis

# SSerHial: serial <-> SSH hub (PyserSSH copy, host key, logs); local tool, not part of the project
SSerHial/
